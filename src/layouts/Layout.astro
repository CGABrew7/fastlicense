---
import '../styles/global.css';
import { SITE } from '../data/site';
import { jsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, canonical, noindex = false } = Astro.props;
const canonicalUrl = canonical
  ? new URL(canonical, SITE.url).toString()
  : new URL(Astro.url.pathname, SITE.url).toString();
const indexable = SITE.publicIndex && !noindex;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon.svg', SITE.url).toString(),
  description: SITE.description,
  parentOrganization: {
    '@type': 'Organization',
    name: SITE.cornerstone.name,
    url: SITE.cornerstone.url,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'licensing filings',
    url: SITE.cornerstone.contact,
    telephone: `+1-${SITE.cornerstone.phone}`,
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index,follow" : "noindex,nofollow"} />
    <meta name="theme-color" content="#101820" />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" is:inline set:html={jsonLd(organization)} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="wrap header-bar">
        <a class="brand" href="/">
          <span class="brand-mark">FL</span>
          <span class="brand-name">
            {SITE.name}
            <span>Timeline directory</span>
          </span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
        <nav class="nav-links" id="nav-links">
          <a href="/licenses/">By license</a>
          <a href="/states/">By state</a>
          <a href="/guides/how-long-does-a-business-license-take/">How long</a>
          <a href="/delays/">Delays</a>
          <a href="/expedite/">Expedite</a>
          <a href="/methodology/">Methods</a>
          <a class="nav-cta" href={SITE.cornerstone.contact} target="_blank" rel="noopener">Ask Cornerstone</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="cta-band">
      <div class="wrap">
        <p class="kicker">Filing desk</p>
        <h2>Ask Cornerstone to sequence the filing calendar.</h2>
        <p>
          {SITE.name} publishes the clocks it can cite. {SITE.cornerstone.name} prepares and files
          collection, lending, money transmitter, and mortgage company applications.
        </p>
        <div class="btn-row">
          <a class="btn btn-solid" href={SITE.cornerstone.contact} target="_blank" rel="noopener">Ask Cornerstone</a>
          <a class="btn btn-ghost" href={`tel:${SITE.cornerstone.phone.replace(/-/g, '')}`}>Call {SITE.cornerstone.phone}</a>
          <a class="btn btn-ghost" href={SITE.cornerstone.url} target="_blank" rel="noopener">cornerstonelicensing.com</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/">
              <span class="brand-mark">FL</span>
              <span class="brand-name">{SITE.name}<span>Timeline desk</span></span>
            </a>
            <p>
              How long licensing takes, what delays a file, and when an expedite actually exists.
              Typical weeks are marked unknown unless a regulator or statute published them.
            </p>
          </div>
          <div>
            <h4>Directory</h4>
            <a href="/licenses/">License types</a>
            <a href="/licenses/collection/">Collection / ARM</a>
            <a href="/licenses/lending/">Lending</a>
            <a href="/licenses/money-transmitter/">Money transmitter</a>
            <a href="/licenses/mortgage/">Mortgage</a>
            <a href="/states/">50 states</a>
          </div>
          <div>
            <h4>How long</h4>
            <a href="/guides/how-long-does-a-business-license-take/">How long a license takes</a>
            <a href="/delays/">What delays filings</a>
            <a href="/expedite/">When to expedite</a>
            <a href="/methodology/">Methods</a>
            <a href="/sitemap.xml">XML sitemap</a>
            <a href="/llms.txt">llms.txt</a>
          </div>
          <div>
            <h4>House</h4>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
            <a href={SITE.sisters.simple.url} target="_blank" rel="noopener">Who / where to file</a>
            <a href={SITE.sisters.store.url} target="_blank" rel="noopener">Costs &amp; providers</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; 2026 {SITE.name} · {SITE.owner}</span>
          <span>Informational only. Not legal advice. Applications are filed by {SITE.cornerstone.name}.</span>
        </div>
        {
          !indexable && (
            <p class="staging-note">
              Private staging for Cornerstone Licensing review. Crawlers are set to noindex.
              This preview is not a public launch of fastlicence.com.
            </p>
          )
        }
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      const toggle = header?.querySelector('.nav-toggle');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>
  </body>
</html>
