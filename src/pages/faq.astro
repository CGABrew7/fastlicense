---
import Layout from '../layouts/Layout.astro';

const faqs = [
  { q: "How fast can I get licensed?", a: "It depends on the license type and state. Simple business licenses can be approved in 5-10 days with fast-track processing. Complex financial licenses (lending, money transmission) take 30-120 days. Use our <a href='/#quiz'>timeline estimator</a> for your specific situation." },
  { q: "What does it cost?", a: "Our service fee ranges from $200 to $8,000 depending on license complexity. Government filing fees are separate and vary by state. We provide an exact quote before you commit to anything. <a href='/pricing'>See our pricing page</a> for ranges by license type." },
  { q: "Who processes my application?", a: "All applications are prepared and filed by <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a>, a firm with 28 years of experience and 525,000+ filings. They maintain a 99.995% on-time submission rate. Your dedicated specialist handles your application from start to finish." },
  { q: "What if I need licenses in multiple states?", a: "That's where we add the most value. Multi-state licensing is complex: different forms, different fees, different requirements in every state. We handle all of it. Your specialist coordinates filings across all states and tracks every deadline. Most multi-state clients see 60-80% time savings compared to doing it themselves." },
  { q: "Do you handle renewals?", a: "Yes. Licenses expire. Our processing partner tracks all renewal deadlines through their Atlas compliance platform and files renewals proactively so you never face a lapse. This is included as part of the ongoing relationship." },
  { q: "What's included in the fee?", a: "Application preparation, document assembly, regulatory filing, status tracking, deficiency response (if the state sends a correction notice), and confirmation of approval. Surety bond procurement is included for licenses that require a bond. Government filing fees are quoted separately since they vary by state." },
  { q: "What licenses do you handle?", a: "We handle 14 common license categories including general business, contractor, collection agency, consumer lender, mortgage lender, money transmitter, cryptocurrency, insurance adjuster, real estate, restaurant, payday lender, debt buyer, home health, and auto dealer. We also handle hundreds of other license types not listed on our site. <a href='/contact'>Contact us</a> if you don't see yours." },
  { q: "How is your first-submission approval rate so high?", a: "97% of our applications are approved on the first submission because our specialists know the exact requirements for every license type in every state. They've done this hundreds of thousands of times. Clean applications mean no correction notices and no weeks of back-and-forth delays." },
  { q: "What happens if my application gets a deficiency notice?", a: "We handle it. If the state requests corrections or additional information, your specialist responds immediately. This is included in your service fee at no extra charge." },
  { q: "Can I track the status of my application?", a: "Yes. Your specialist provides status updates throughout the process. You'll know where your application stands and when to expect approval." },
  { q: "What's the difference between fast-track and standard processing?", a: "Fast-track means we prioritize your application for immediate preparation and filing, and we use every available expediting option with the state. Standard processing follows the normal preparation and state review timeline. Both get the same quality of work; fast-track just gets it done sooner." },
  { q: "Do I need a surety bond?", a: "Some license types require surety bonds. Our <a href='/licenses'>license type pages</a> indicate which ones do. If your license requires a bond, we handle procurement as part of your application. You don't need a separate bond broker." }
];
---

<Layout title="FAQ — FastLicense" description="Answers to common questions about fast-track business licensing.">
  <section class="page-hero">
    <div class="container">
      <h1>Frequently Asked Questions</h1>
      <p>Answers to common questions about licensing with FastLicense.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}<span class="faq-toggle">+</span></summary>
          <div class="faq-a" set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Still Have Questions?</h2>
      <p>Contact us and we'll respond within 1 business day.</p>
      <a href="/contact">Contact Us</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--dark) 0%, #1a2744 50%, var(--dark-mid) 100%);
    padding: 56px 0 48px;
    text-align: center;
    color: white;
  }
  .page-hero h1 { font-size: 2.2rem; font-weight: 900; margin-bottom: 8px; }
  .page-hero p { color: #94A3B8; font-size: 1.05rem; }
</style>
