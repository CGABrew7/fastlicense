---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Contact — FastLicense"
  description="Contact Cornerstone Licensing about a filing calendar. FastLicense does not host an application form."
>
  <section class="masthead">
    <div class="wrap">
      <p class="kicker">Contact</p>
      <h1>Talk to the filing desk.</h1>
      <p class="lede">
        FastLicense is a directory. It does not take applications or quotes on this domain. The
        operating partner is {SITE.cornerstone.name}.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>{SITE.cornerstone.name}</h2>
      <p>
        Phone: <a href={`tel:${SITE.cornerstone.phone.replace(/-/g, '')}`}>{SITE.cornerstone.phone}</a>
      </p>
      <p>
        Web: <a href={SITE.cornerstone.contact}>{SITE.cornerstone.contact}</a>
      </p>
      <p>
        Use that desk for a timeline review of a real file. Do not send social-security numbers or
        full financials to a satellite inbox.
      </p>

      <h2>Editorial corrections</h2>
      <p>
        If a cited statute or regulator page has moved, or a published processing-time notice
        changed, that is an editorial fix for this directory. Start at
        <a href="/methodology/">methods</a> so we can attach a new source instead of a guess.
      </p>
    </div>
  </section>
</Layout>
