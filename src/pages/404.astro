---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | FastLicence" description="That URL is not in the FastLicence directory." noindex>
  <section class="masthead">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>This page is not in the directory.</h1>
      <p class="lede">
        Try <a href="/licenses/">license types</a> or the <a href="/states/">50-state index</a>.
      </p>
    </div>
  </section>
</Layout>
