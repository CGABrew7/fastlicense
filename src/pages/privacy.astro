---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Privacy — FastLicense"
  description="FastLicense privacy policy. This site is a static directory. Contact goes to Cornerstone Licensing."
>
  <section class="masthead">
    <div class="wrap">
      <p class="kicker">Privacy</p>
      <h1>What this static directory collects.</h1>
      <p class="lede">Last updated August 2026.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>This site</h2>
      <p>
        FastLicense is a static public directory. There is no account system and no application
        form hosted here. Pages are HTML files.
      </p>

      <h2>Logs and analytics</h2>
      <p>
        The host (intended: Cloudflare Pages) may keep standard request logs — IP address, user
        agent, and the page requested — to operate the site and stop abuse. We do not run
        advertising pixels on these pages.
      </p>

      <h2>If you contact Cornerstone</h2>
      <p>
        Links labeled Contact Cornerstone go to
        <a href={SITE.cornerstone.contact}>{SITE.cornerstone.name}</a>. Information you send there
        is handled under Cornerstone’s own privacy terms, not by this satellite.
      </p>

      <h2>Questions</h2>
      <p>
        Privacy questions about this directory: use the <a href="/contact/">contact page</a>.
        Questions about an application file: write Cornerstone directly.
      </p>
    </div>
  </section>
</Layout>
