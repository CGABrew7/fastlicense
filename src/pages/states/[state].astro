---
import Layout from '../../layouts/Layout.astro';
import { getStateBySlug, STATES } from '../../data/states';
import { LICENSES } from '../../data/licenses';
import { recordFor } from '../../lib/catalog';
import StatuteHistory from '../../components/StatuteHistory.astro';
import { statuteHistoryForState } from '../../data/statuteHistory';

export function getStaticPaths() {
  return STATES.map((s) => ({ params: { state: s.slug } }));
}

const state = getStateBySlug(Astro.params.state!);
if (!state) throw new Error('Unknown state');

const rows = LICENSES.map((l) => recordFor(state, l));
const statuteHistory = statuteHistoryForState(state.code);
const missingCores = statuteHistory
  ? LICENSES.filter(
      (license) => !statuteHistory.groups.some((group) => group.license === license.id),
    ).map((license) => license.shortName)
  : [];
const statutePreamble =
  missingCores.length === 0
    ? undefined
    : missingCores.length === 1
      ? `No verified statute file for ${missingCores[0]} in this corpus, so that core is not linked.`
      : `No verified statute file for ${missingCores.join(', ')} in this corpus, so those cores are not linked.`;
---

<Layout
  title={`${state.name} licensing timelines — FastLicense`}
  description={`${state.name} timelines for collection, lending, money transmitter, and mortgage company licenses.`}
>
  <section class="masthead">
    <div class="wrap">
      <p class="crumbs"><a href="/states/">States</a> / {state.name}</p>
      <p class="kicker">{state.code}</p>
      <h1>{state.name} timelines</h1>
      <p class="lede">
        Four cores. Typical week ranges stay unknown unless a regulator or statute published them.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {
        rows.map((r) => (
          <a class="tile" href={`/licenses/${r.license.slug}/${state.slug}/`} style="margin-bottom:12px">
            <h2>{r.license.name}</h2>
            <p>
              <span class={r.typicalPublished ? 'known' : 'unknown'}>{r.typicalLabel}</span>
            </p>
            <p class="meta" style="margin-top:8px">
              {r.clocks[0]?.label ?? 'No cited clock'} · {r.regulators[0]?.name}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  {
    statuteHistory && (
      <section class="section">
        <div class="wrap">
          <StatuteHistory
            groups={statuteHistory.groups}
            textAttribution={statuteHistory.textAttribution}
            corpusLicenseUrl={statuteHistory.corpusLicenseUrl}
            preamble={statutePreamble}
          />
        </div>
      </section>
    )
  }
</Layout>
