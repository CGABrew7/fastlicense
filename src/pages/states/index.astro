---
import Layout from '../../layouts/Layout.astro';
import StatuteHistory from '../../components/StatuteHistory.astro';
import { STATES } from '../../data/states';
import { clocksForState } from '../../data/clocks';
import { districtStatuteHistory } from '../../data/statuteHistory';

const district = districtStatuteHistory();
---

<Layout
  title="State licensing timelines | FastLicense"
  description="50-state index of collection, lending, money transmitter, and mortgage licensing timelines."
>
  <section class="masthead">
    <div class="wrap">
      <p class="kicker">By state</p>
      <h1>Fifty states, same four cores.</h1>
      <p class="lede">
        Each state page lists collection, lending, money transmitter, and mortgage. Cited clocks
        appear where we have a statute or a regulator timeframe.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap state-grid">
      {
        STATES.map((s) => {
          const n = clocksForState(s.code).length;
          return (
            <a class="tile" href={`/states/${s.slug}/`}>
              <strong>{s.name}</strong>
              <span class="meta" style="display:block;margin-top:4px">
                {n ? `${n} cited clock${n === 1 ? '' : 's'}` : 'Typical ranges unknown'}
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  {
    district && (
      <section class="section">
        <div class="wrap">
          <StatuteHistory
            groups={district.groups}
            textAttribution={district.textAttribution}
            corpusLicenseUrl={district.corpusLicenseUrl}
            preamble="The District of Columbia has no state page in this directory. The files below are D.C. Code sections verified in the Global Law corpus. No collection agency license file was verified in that corpus, so collection is not linked."
          />
        </div>
      </section>
    )
  }
</Layout>
