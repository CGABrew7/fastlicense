---
import Layout from '../layouts/Layout.astro';
import { LICENSES } from '../data/licenses';
import { SITE } from '../data/site';
import { CLOCKS } from '../data/clocks';
import { STATES } from '../data/states';

const cited = CLOCKS.length;
const pages = STATES.length * LICENSES.length;
---

<Layout title="FastLicense — Cited timelines for U.S. licensing">
  <section class="masthead">
    <div class="wrap">
      <p class="kicker">Statutory clocks · published waits · delays by state</p>
      <h1>Cited timelines for U.S. business licensing.</h1>
      <p class="lede">
        Statutory clocks, regulator-published waits, and common delays by state, for
        Cornerstone’s four cores: collection / ARM, consumer lending, money transmitters,
        and mortgage companies. A typical processing range is shown when a regulator page or
        a cited statute publishes it, and marked unknown otherwise.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Four cores</h2>
      <p class="note" style="margin-bottom:16px">
        {pages} state × license pages. {cited} clocks with a statute or a regulator-published
        timeframe. The rest stay blank on purpose.
      </p>
      <div class="core-grid">
        {
          LICENSES.map((l) => (
            <a class="tile" href={`/licenses/${l.slug}/`}>
              <h3>{l.name}</h3>
              <p class="meta">{l.core}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="prose">
        <h2>What this site is for</h2>
        <p>
          Three questions, and only those: how long a filed application can sit, what commonly
          stops the clock, and whether a real expedite exists. We cite NMLS, CSBS, state statutes,
          and regulator processing-time pages.
        </p>
        <p>
          We do not invent “fast-track: 21–45 days.” We do not rank vendors. We do not decide who
          must file, or in which office.
        </p>
      </div>
      <div class="prose">
        <h2>What the sisters do</h2>
        <p>
          <a href={SITE.sisters.simple.url}>{SITE.sisters.simple.name}</a> covers {SITE.sisters.simple.job}.
        </p>
        <p>
          <a href={SITE.sisters.store.url}>{SITE.sisters.store.name}</a> covers {SITE.sisters.store.job}.
        </p>
        <p>
          Filing work goes to <a href={SITE.cornerstone.url}>{SITE.cornerstone.name}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Start with the cited delay</h2>
      <div class="grid-2" style="margin-top:16px">
        <a class="tile" href="/delays/">
          <h3>What delays a file</h3>
          <p class="meta">Incomplete applications, FBI name checks, MU2 gaps, bonds, exams.</p>
        </a>
        <a class="tile" href="/expedite/">
          <h3>When expedite is real</h3>
          <p class="meta">Most of these licenses have no paid skip-the-line window.</p>
        </a>
        <a class="tile" href="/states/">
          <h3>50-state index</h3>
          <p class="meta">One page per state, all four cores.</p>
        </a>
        <a class="tile" href="/methodology/">
          <h3>How we mark unknown</h3>
          <p class="meta">Statutory clock ≠ typical wait. We keep them apart.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
