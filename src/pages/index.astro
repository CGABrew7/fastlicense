---
import Layout from '../layouts/Layout.astro';
import TimelineQuiz from '../components/TimelineQuiz.jsx';
import data from '../data/licenses.json';

const faqs = [
  { q: "How fast can I get licensed?", a: "It depends on the license type and state. Simple business licenses can be approved in 5-10 days with fast-track processing. Complex financial licenses (lending, money transmission) take 30-120 days. Use our timeline estimator above for your specific situation." },
  { q: "What does it cost?", a: "Our service fee ranges from $200 to $8,000 depending on license complexity. Government filing fees are separate and vary by state. We provide an exact quote before you commit to anything. <a href='/pricing'>See our pricing page</a> for ranges by license type." },
  { q: "Who processes my application?", a: "All applications are prepared and filed by <a href='https://cornerstonelicensing.com' target='_blank' rel='noopener'>Cornerstone Licensing</a>, a firm with 28 years of experience and 525,000+ filings. They maintain a 99.995% on-time submission rate. Your dedicated specialist handles your application from start to finish — no handoffs." },
  { q: "What if I need licenses in multiple states?", a: "That's where we add the most value. Multi-state licensing is complex — different forms, different fees, different requirements in every state. We handle all of it. Your specialist coordinates filings across all states and tracks every deadline. Most multi-state clients see 60-80% time savings vs. doing it themselves." },
  { q: "Do you handle renewals?", a: "Yes. Licenses expire. Our processing partner tracks all renewal deadlines through their Atlas compliance platform and files renewals proactively so you never face a lapse. This is included as part of the ongoing relationship." },
  { q: "What's included in the fee?", a: "Application preparation, document assembly, regulatory filing, status tracking, deficiency response (if the state sends a correction notice), and confirmation of approval. Surety bond procurement is included for licenses that require a bond. Government filing fees are quoted separately since they vary by state." }
];
---

<Layout title="FastLicense — Get Licensed Fast">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>Get Licensed <span>Fast.</span><br/>Not Someday.</h1>
      <p>Tell us what you need. We'll tell you how fast you can have it. Then we'll make it happen.</p>
      <a href="#quiz" class="hero-cta">Get Your Timeline</a>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="container">
      <div class="trust-bar-inner">
        <div class="trust-item"><strong>525K+</strong> licenses filed</div>
        <div class="trust-item"><strong>28</strong> years experience</div>
        <div class="trust-item"><strong>50</strong> states covered</div>
        <div class="trust-item"><strong>99.995%</strong> on-time rate</div>
      </div>
    </div>
  </div>

  <!-- SPEED PROOF -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Why Businesses Choose FastLicense</h2>
      <p class="section-sub">We focus on one thing: getting you licensed as fast as possible with zero mistakes.</p>
      <div class="speed-grid">
        <div class="speed-card">
          <div class="speed-number">3 days</div>
          <div class="speed-label">Average filing preparation time. Your application is assembled and submitted within 3 business days of receiving your information.</div>
        </div>
        <div class="speed-card">
          <div class="speed-number">97%</div>
          <div class="speed-label">First-submission approval rate. Clean applications get approved faster. No correction notices. No back-and-forth delays.</div>
        </div>
        <div class="speed-card">
          <div class="speed-number">25-30x</div>
          <div class="speed-label">Faster than doing it yourself. Our specialists know every form, every requirement, every shortcut in every state.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE QUIZ -->
  <section class="section section-white" id="quiz-section">
    <div class="container">
      <h2 class="section-title">How Fast Can You Get Licensed?</h2>
      <p class="section-sub">3 questions. 30 seconds. Your estimated timeline and cost.</p>
      <TimelineQuiz client:load />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Three Steps. That's It.</h2>
      <p class="section-sub">No learning curve. No portal to figure out. No back-and-forth.</p>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Tell us what you need</h3>
          <p>Answer a few questions about your business, state, and license type. Takes under 2 minutes.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>We prepare and file</h3>
          <p>Your dedicated specialist assembles the application, gathers required documents, and files with the state.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>You're licensed</h3>
          <p>We track the application through approval and deliver your license. Renewals are tracked automatically.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LICENSE TYPES -->
  <section class="section section-white">
    <div class="container">
      <h2 class="section-title">License Types We Handle</h2>
      <p class="section-sub">Fast-track processing for the most common business license types.</p>
      <div class="license-grid">
        {data.types.map(t => (
          <a href={`/licenses/${t.id}`} class="license-tile">
            {t.name}
            <span class="tile-time">Fast-track: {t.fast}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div style="margin-top: 32px;">
        {faqs.map(f => (
          <details class="faq-item">
            <summary class="faq-q">{f.q}<span class="faq-toggle">+</span></summary>
            <div class="faq-a" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready to Get Licensed?</h2>
      <p>Get your estimated timeline in 30 seconds. No commitment. No sales pitch.</p>
      <a href="#quiz">Get Your Timeline</a>
    </div>
  </section>

</Layout>
