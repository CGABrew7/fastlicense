---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/licenses.json';

export function getStaticPaths() {
  return data.types.map(t => ({ params: { id: t.id }, props: { license: t } }));
}

const { license } = Astro.props;

const descriptions: Record<string, string> = {
  "general-business": "A general business license authorizes you to operate a business within a specific city or county. Requirements vary by jurisdiction, but nearly every business needs one. This is typically the fastest license to obtain.",
  "contractor": "Contractor licenses are required in most states for businesses performing construction, electrical, plumbing, HVAC, or other trade work. Most states require proof of experience, an exam, and a surety bond.",
  "collection-agency": "Collection agency licenses are required in most states for businesses that collect debts on behalf of others or purchase debt portfolios. Requirements typically include a surety bond, net worth minimums, and background checks.",
  "consumer-lender": "Consumer lender licenses (also called consumer finance licenses) are required for businesses making loans to individuals. Requirements include net worth minimums, surety bonds, and detailed financial disclosures.",
  "mortgage-lender": "Mortgage lender and broker licenses are required for businesses originating or brokering residential mortgage loans. This is one of the most heavily regulated license types, with NMLS filing requirements in every state.",
  "money-transmitter": "Money transmitter licenses are required for businesses that transfer funds on behalf of others. This includes payment processors, prepaid card issuers, and digital wallet providers. Requirements are extensive: surety bonds (often $500K+), audited financials, detailed business plans, and background checks.",
  "cryptocurrency": "Cryptocurrency licenses (including BitLicenses in New York) are required for businesses dealing in virtual currency. Requirements mirror money transmitter licenses in most states, with additional cybersecurity and compliance requirements.",
  "insurance-adjuster": "Insurance adjuster licenses authorize individuals and firms to investigate and settle insurance claims. Requirements typically include pre-licensing education, an exam, and state-specific continuing education.",
  "real-estate": "Real estate broker licenses authorize businesses to facilitate real estate transactions. Requirements vary by state but typically include experience as a licensed agent, additional education, and an exam.",
  "restaurant": "Restaurant and food service licenses encompass health permits, food handler certifications, liquor licenses, and general business permits. Requirements vary significantly by jurisdiction.",
  "payday-lender": "Payday and small dollar lender licenses are required for businesses offering short-term, small-amount loans. Heavily regulated with strict net worth requirements, surety bonds, and rate/fee caps in many states.",
  "debt-buyer": "Debt buyer licenses are required in many states for businesses that purchase delinquent debt portfolios. Requirements typically include surety bonds, financial disclosures, and compliance with state collection laws.",
  "home-health": "Home health agency licenses authorize businesses to provide in-home healthcare services. Requirements include detailed policies and procedures, staffing plans, background checks, and state health department inspections.",
  "auto-dealer": "Auto dealer licenses authorize businesses to buy and sell motor vehicles. Requirements typically include a physical location, surety bond, proper zoning, and completion of a dealer training program."
};

const desc = descriptions[license.id] || `${license.name} licensing requirements vary by state. We handle the research, preparation, and filing for you across all 50 states.`;
---

<Layout title={`${license.name} — FastLicense`} description={`Fast-track ${license.name.toLowerCase()} processing. ${license.fast} with expedited service.`}>
  <section class="page-hero">
    <div class="container">
      <h1>{license.name}</h1>
      <p>Fast-track available: <strong>{license.fast}</strong></p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 800px;">
      <div class="detail-grid">
        <div class="detail-card accent">
          <div class="dc-label">Fast-Track Timeline</div>
          <div class="dc-value">{license.fast}</div>
        </div>
        <div class="detail-card">
          <div class="dc-label">Standard Timeline</div>
          <div class="dc-value">{license.standard}</div>
        </div>
        <div class="detail-card">
          <div class="dc-label">Our Service Fee</div>
          <div class="dc-value">{license.cost}</div>
        </div>
        <div class="detail-card">
          <div class="dc-label">Gov. Filing Fees</div>
          <div class="dc-value">{license.govFee}</div>
        </div>
      </div>

      {license.bond && (
        <div class="bond-notice">
          <strong>Surety bond required.</strong> This license type requires a surety bond in most states. We handle bond procurement as part of your application — no separate broker needed.
        </div>
      )}

      <div class="desc-section">
        <h2>About This License</h2>
        <p>{desc}</p>
      </div>

      <div class="desc-section">
        <h2>What We Handle</h2>
        <div class="included-grid">
          <div class="included-item">
            <div class="inc-check">✓</div>
            <div>
              <strong>Application preparation</strong>
              <p>Every form completed correctly. Our 97% first-submission approval rate means no correction delays.</p>
            </div>
          </div>
          <div class="included-item">
            <div class="inc-check">✓</div>
            <div>
              <strong>Document assembly</strong>
              <p>We tell you exactly what documents are needed, then compile and organize everything for submission.</p>
            </div>
          </div>
          <div class="included-item">
            <div class="inc-check">✓</div>
            <div>
              <strong>Regulatory filing</strong>
              <p>Submitted to the correct agency with correct fees. We know the specific requirements for every state.</p>
            </div>
          </div>
          <div class="included-item">
            <div class="inc-check">✓</div>
            <div>
              <strong>Status tracking</strong>
              <p>You'll know where your application stands. We monitor progress and communicate updates proactively.</p>
            </div>
          </div>
          <div class="included-item">
            <div class="inc-check">✓</div>
            <div>
              <strong>Deficiency response</strong>
              <p>If the state requests corrections or additional information, we handle the response immediately.</p>
            </div>
          </div>
          {license.bond && (
            <div class="included-item">
              <div class="inc-check">✓</div>
              <div>
                <strong>Surety bond procurement</strong>
                <p>We secure your required bond as part of the application process. No separate broker needed.</p>
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="desc-section">
        <h2>Covered in All 50 States</h2>
        <p>We file {license.name.toLowerCase()} applications in every U.S. state. Requirements, fees, and timelines vary by jurisdiction. Our specialists know the specific rules for each state, so you don't have to.</p>
        <p>Need to be licensed in multiple states? That's where we add the most value. Multi-state filings are coordinated by a single specialist who tracks every deadline across all jurisdictions.</p>
      </div>

      <div class="cta-box">
        <h3>Get Your {license.name} Timeline</h3>
        <p>See your estimated processing time and cost for your specific state.</p>
        <a href="/#quiz" class="btn" style="display: inline-block; width: auto; padding: 14px 32px;">Get My Timeline</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--dark) 0%, #1a2744 50%, var(--dark-mid) 100%);
    padding: 56px 0 48px;
    text-align: center;
    color: white;
  }
  .page-hero h1 { font-size: 2.2rem; font-weight: 900; margin-bottom: 8px; }
  .page-hero p { color: #94A3B8; font-size: 1.05rem; }
  .page-hero strong { color: var(--gold); }

  .detail-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
  .detail-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
  }
  .detail-card.accent {
    background: var(--primary-light);
    border-color: var(--primary-border);
  }
  .dc-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted); margin-bottom: 4px; }
  .dc-value { font-size: 1.15rem; font-weight: 800; color: var(--text); }
  .detail-card.accent .dc-value { color: var(--primary); }

  .bond-notice {
    background: var(--gold-bg);
    border: 1px solid #FDE68A;
    border-radius: var(--radius);
    padding: 16px 20px;
    font-size: 0.9rem;
    color: #92400E;
    margin-bottom: 32px;
  }

  .desc-section { margin-bottom: 36px; }
  .desc-section h2 { font-size: 1.3rem; margin-bottom: 12px; }
  .desc-section p { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 10px; }

  .included-grid { display: flex; flex-direction: column; gap: 16px; }
  .included-item { display: flex; gap: 14px; align-items: flex-start; }
  .inc-check {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--green-bg);
    color: var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    margin-top: 2px;
  }
  .included-item strong { display: block; font-size: 0.95rem; margin-bottom: 2px; }
  .included-item p { font-size: 0.88rem; color: var(--text-secondary); margin: 0; }

  .cta-box {
    background: linear-gradient(135deg, var(--dark) 0%, var(--dark-mid) 100%);
    border-radius: var(--radius-lg);
    padding: 36px;
    text-align: center;
    color: white;
    margin-top: 40px;
  }
  .cta-box h3 { font-size: 1.3rem; margin-bottom: 8px; }
  .cta-box p { color: #94A3B8; margin-bottom: 20px; font-size: 0.95rem; }

  @media (max-width: 768px) {
    .detail-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
