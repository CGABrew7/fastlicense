---
import Layout from '../../layouts/Layout.astro';
import { LICENSES } from '../../data/licenses';
import { clocksForLicense } from '../../data/clocks';
import { STATES } from '../../data/states';
---

<Layout
  title="License timelines — FastLicense"
  description="Timeline directory for collection, lending, money transmitter, and mortgage company licenses across 50 states."
>
  <section class="masthead">
    <div class="wrap">
      <p class="kicker">By license type</p>
      <h1>Four cores, fifty states each.</h1>
      <p class="lede">
        Open a type for the national picture, then a state for the local clock — or the honest
        unknown.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {
        LICENSES.map((l) => {
          const clocks = clocksForLicense(l.id);
          return (
            <a class="tile" href={`/licenses/${l.slug}/`} style="margin-bottom:12px">
              <h2>{l.name}</h2>
              <p>{l.summary}</p>
              <p class="meta" style="margin-top:8px">
                {STATES.length} state pages · {clocks.length} cited clock{clocks.length === 1 ? '' : 's'}
              </p>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
