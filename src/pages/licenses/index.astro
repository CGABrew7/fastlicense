---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/licenses.json';
---

<Layout title="License Types — FastLicense" description="Fast-track processing for 14 business license types across all 50 states.">
  <section class="page-hero">
    <div class="container">
      <h1>License Types We Handle</h1>
      <p>Fast-track processing for the most common business license types across all 50 states.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="license-list">
        {data.types.map(t => (
          <a href={`/licenses/${t.id}`} class="license-row">
            <div class="lr-info">
              <h3>{t.name}</h3>
              <div class="lr-meta">
                <span class="lr-fast">Fast-track: {t.fast}</span>
                <span class="lr-standard">Standard: {t.standard}</span>
              </div>
            </div>
            <div class="lr-cost">
              <div class="lr-cost-label">Service fee</div>
              <div class="lr-cost-value">{t.cost}</div>
            </div>
            <div class="lr-arrow">→</div>
          </a>
        ))}
      </div>

      <div class="license-note">
        <p><strong>Don't see your license type?</strong> We handle hundreds of license categories beyond what's listed here. <a href="/contact">Contact us</a> with your specific needs and we'll provide a timeline and quote within 1 business day.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Get Your Timeline Now</h2>
      <p>Pick your license type, state, and urgency. See your estimated timeline in 30 seconds.</p>
      <a href="/#quiz">Get Your Timeline</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--dark) 0%, #1a2744 50%, var(--dark-mid) 100%);
    padding: 56px 0 48px;
    text-align: center;
    color: white;
  }
  .page-hero h1 { font-size: 2.2rem; font-weight: 900; margin-bottom: 8px; }
  .page-hero p { color: #94A3B8; font-size: 1.05rem; max-width: 540px; margin: 0 auto; }

  .license-list { display: flex; flex-direction: column; gap: 12px; }
  .license-row {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
  }
  .license-row:hover {
    border-color: var(--primary-border);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .lr-info { flex: 1; }
  .lr-info h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .lr-meta { display: flex; gap: 16px; flex-wrap: wrap; }
  .lr-fast { font-size: 0.82rem; font-weight: 700; color: var(--primary); }
  .lr-standard { font-size: 0.82rem; color: var(--text-muted); }
  .lr-cost { text-align: right; flex-shrink: 0; }
  .lr-cost-label { font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.3px; }
  .lr-cost-value { font-size: 0.95rem; font-weight: 700; color: var(--text); }
  .lr-arrow { font-size: 1.2rem; color: var(--text-muted); flex-shrink: 0; }

  .license-note {
    margin-top: 32px;
    background: var(--primary-light);
    border: 1px solid var(--primary-border);
    border-radius: var(--radius);
    padding: 20px 24px;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
  .license-note a { font-weight: 600; }

  @media (max-width: 768px) {
    .license-row { flex-direction: column; align-items: flex-start; gap: 8px; }
    .lr-cost { text-align: left; }
    .lr-arrow { display: none; }
  }
</style>
